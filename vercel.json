{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": {
      "root": "admin",
      "framework": "vite"
    },
    "public": {
      "root": "public",
      "framework": "vite"
    },
    "registration": {
      "root": "registration",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "register.nacosoutheast.org.ng"
        }
      ],
      "destination": {
        "service": "registration"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "public"
      }
    }
  ]
}
